# Официальный HTTPS-домен для canonical, hreflang, Open Graph, robots и sitemap.
# По умолчанию используется https://vakhshsanoat.com (можно не задавать).
# Переопределение: NEXT_PUBLIC_SITE_URL=https://другой-домен
# Отключить индексацию (локально/preview): NEXT_PUBLIC_SITE_URL=off
# Preview на *.pages.dev дополнительно закрыт X-Robots-Tag в public/_headers.
NEXT_PUBLIC_SITE_URL=https://vakhshsanoat.com
